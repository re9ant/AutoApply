# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Candidate Profile
CANDIDATE_PROFILE_PATH=candidate/profile.json
RESUMES_DIR=resumes

# Excel Application Tracker
EXCEL_TRACKER_PATH=data/tracker.xlsx
EXCEL_AUTO_BACKUP=true

# Database (Default: local SQLite file)
DATABASE_URL=sqlite+aiosqlite:///data/autoapply.db

# Match Scoring Thresholds
MINIMUM_AUTO_APPLY_SCORE=75
MINIMUM_REVIEW_SCORE=60
